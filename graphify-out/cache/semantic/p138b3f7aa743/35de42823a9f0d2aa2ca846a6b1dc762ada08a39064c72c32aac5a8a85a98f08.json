{"nodes": [{"id": "free_fire_live_kill_tracker_tech_stack_system_blueprint", "label": "Free Fire Live Kill-Tracking & Leaderboard System Tech Stack", "file_type": "document", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L1-L4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_cpu_first_inference", "label": "CPU-First Inference Principle", "file_type": "rationale", "rationale": "Uses ONNX Runtime for both icon detection and OCR so the pipeline runs smoothly on a single broadcast machine (even an 8 GB RAM laptop without a dedicated NVIDIA GPU), avoiding multi-gigabyte PyTorch runtimes.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L9", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_zero_state_drift", "label": "Zero State Drift Principle", "file_type": "rationale", "rationale": "Stores all kills as immutable event records and aggregates team totals and rankings dynamically rather than mutating counters in place, enabling instant undo and audit.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_closed_set_verification", "label": "Closed-Set Verification Principle", "file_type": "rationale", "rationale": "Matches noisy OCR strings against a known 48-player lobby manifest instead of trusting raw text output.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L11", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_human_in_the_loop_safety_net", "label": "Human-in-the-Loop Safety Net", "file_type": "rationale", "rationale": "Pairs automated detection with a 1-click Referee Dashboard during the natural 10-30 second broadcast delay to resolve low-confidence crops before viewers see updates.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L12", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_stream_capture", "label": "OBS Studio / MediaMTX RTMP / NDI Stream Capture", "file_type": "concept", "rationale": "Captures directly from the observer PC via OBS Virtual Camera or local MediaMTX RTMP rather than scraping YouTube/Twitch streams because avoiding re-compression preserves sharp HUD text edges.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L20, L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_roi_preprocessing", "label": "ROI Cropping & Image Conditioning (OpenCV + NumPy)", "file_type": "concept", "rationale": "Samples at 4-5 FPS (200-250 ms) into ROI_KILLFEED, ROI_ALIVE, and ROI_GUARD, applying 2x-3x bicubic upscaling, grayscale, CLAHE, and adaptive thresholding to isolate bright HUD text from explosions or sky backgrounds.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L21, L39-L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_change_gating_ssim", "label": "SSIM / absdiff Change Gating", "file_type": "rationale", "rationale": "Uses scikit-image SSIM or OpenCV absdiff to skip static frames in under 3 ms, cutting CPU load by 70-85%.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L22, L173", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_yolov11_nano_onnx_detector", "label": "YOLOv11-nano ONNX Icon & Split Detection", "file_type": "concept", "rationale": "Delivers sub-15 ms CPU inference on ff_icons_v11n.onnx to discard KNOCKDOWN banners before OCR and split ELIMINATION banners at the center icon bounding box (x_min, x_max) into Left=Killer and Right=Victim so names never bleed together.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L23, L45-L50, L93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_rapidocr_recognition", "label": "RapidOCR Text Recognition", "file_type": "concept", "rationale": "Lightweight ONNX port of PaddleOCR models that handles sharp outlines and stylized gaming fonts significantly better than Tesseract on CPU in 25-45 ms.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L24, L53, L175", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_ascii_skeleton_rapidfuzz_matcher", "label": "ASCII Skeleton Normalization & RapidFuzz Matching", "file_type": "concept", "rationale": "Strips decorative Unicode characters via unicodedata and scores against 48 player skeletons via RapidFuzz WRatio/partial_ratio in under 1 ms, routing >=85% to consensus, 65-84% to multi-frame hold, and <65% to Referee Dashboard.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L25, L54-L58", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_temporal_consensus_revival_cooldown", "label": "Temporal Consensus & 15s Revival Cooldown", "file_type": "rationale", "rationale": "Requires matching (killer_id, victim_id) in at least 2 of 3 consecutive frames and applies a 15-second sliding hash cooldown\u2014long enough to prevent double-counting a 4-5s banner, short enough to count Free Fire revivals.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L59-L61, L177", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_event_sourced_ranking_backend", "label": "Event-Sourced Ranking Backend (Node.js + Express + Socket.IO + SQLite WAL)", "file_type": "concept", "rationale": "Runs SQLite better-sqlite3 in WAL mode for fast concurrent reads/writes with zero external DB server overhead, storing immutable kill_events (ACTIVE|VOIDED|PENDING_REVIEW) and deterministic tie-breakers (total_kills desc, alive_players desc, first_to_reach_timestamp asc).", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L26-L27, L63-L73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_obs_broadcast_overlay", "label": "Live OBS Broadcast Overlay (/overlay)", "file_type": "concept", "rationale": "React, Vite, Tailwind CSS, and Framer Motion layout-animated Browser Source loaded at 1920x1080 with transparent background for rank swaps, kill-pop badges, and eliminated-squad dimming.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L28, L76", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_referee_dashboard", "label": "Referee Dashboard (/referee)", "file_type": "concept", "rationale": "React + Socket.IO Client console on local network showing live kill ticker, Alive mismatch alerts, and low-confidence (<85%) verification queue with Confirm / Reassign / Undo.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L29, L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_model_training_validation", "label": "YOLOv11n Model Training & Offline Benchmark", "file_type": "concept", "rationale": "Extracts 1080p VOD frames via ffmpeg, annotates in Roboflow/LabelImg, trains on Google Colab T4 GPU with Ultralytics ONNX export (imgsz=320 simplify=True), and benchmarks Precision/Recall/F1 > 98.5% against ground-truth CSV.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L30, L193-L198", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_vision_worker_blueprint_deps", "label": "Vision Engine Dependency Blueprint", "file_type": "concept", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L123-L133", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "free_fire_live_kill_tracker_tech_stack_end_to_end_latency_budget", "label": "End-to-End Latency Budget (260-495 ms)", "file_type": "concept", "rationale": "Achieves under half a second from active kill banner to leaderboard render across frame grab/SSIM, ONNX icon split, RapidOCR, RapidFuzz, 2-of-3 consensus hold, and SQLite/Socket.IO/OBS render.", "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L169-L179", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "free_fire_live_kill_tracker_tech_stack_system_blueprint", "target": "free_fire_live_kill_tracker_tech_stack_cpu_first_inference", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L7-L9", "weight": 1.0}, {"source": "free_fire_live_kill_tracker_tech_stack_system_blueprint", "target": "free_fire_live_kill_tracker_tech_stack_zero_state_drift", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "free_fire_live_kill_tracker_tech_stack.md", "source_location": "L7-L10", "weight": 1.0}, {"source": "free_fire_live_kill_tracker_tech_stack_system_blueprint", "target": "free_fire_live_kill_tracker_tech_stack_closed_set_verification", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_